# Copie para .env.production e preencha antes de subir docker-compose.prod.yml:
#   cp .env.production.example .env.production
#
# O compose recusa subir (com uma mensagem clara) se um valor marcado como obrigatório abaixo
# ficar em branco — não tem "esqueceu, caiu num padrão inseguro em produção" por acidente.

# --- Banco de dados -----------------------------------------------------------------------
MYSQL_DATABASE=regula_rpps
MYSQL_USER=regula
MYSQL_PASSWORD=                 # obrigatório — senha do usuário da aplicação no MySQL
MYSQL_ROOT_PASSWORD=            # obrigatório — senha do root do MySQL (só o container usa)

# --- API ------------------------------------------------------------------------------------
JWT_SECRET=                     # obrigatório — string longa e aleatória, ex.: openssl rand -hex 32
ANTHROPIC_API_KEY=              # opcional — sem ela, extração de PDF/Construtor rodam em modo sem IA

# Super Admin criado automaticamente no primeiro boot (login em /admin).
SUPER_ADMIN_EMAIL=admin@suaempresa.com.br
SUPER_ADMIN_PASSWORD=           # obrigatório — troque a senha pela tela de Usuários depois do primeiro login

# NUNCA true num servidor com dado real de cliente: cria um tenant fictício ("Prefeitura de Vale
# Verde") com CRP/Pró-Gestão preenchidos de exemplo e um segundo login de demonstração fixo.
SEED_DEMO_DATA=false

# --- Web ------------------------------------------------------------------------------------
WEB_PORT=80                     # porta do host que serve o frontend (ex.: 80, ou 8080 se já tiver algo na 80)
