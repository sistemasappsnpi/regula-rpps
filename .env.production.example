# Copie para .env.production e preencha antes de subir docker-compose.prod.yml:
#   cp .env.production.example .env.production
#
# O compose recusa subir (com uma mensagem clara) se um valor marcado como obrigatório abaixo
# ficar em branco — não tem "esqueceu, caiu num padrão inseguro em produção" por acidente.

# --- Banco de dados -----------------------------------------------------------------------
# Obrigatório: string de conexão completa. Aponte pro banco dedicado de produção:
#   DATABASE_URL=mysql://usuario:senha@host-do-banco:3306/previdencianpi_db
# Só preencha MYSQL_* abaixo se for usar o MySQL embutido no compose (profile "local-db") em vez
# de um banco externo — nesse caso DATABASE_URL vira mysql://regula:MYSQL_PASSWORD@mysql:3306/regula_rpps.
DATABASE_URL=
MYSQL_DATABASE=regula_rpps
MYSQL_USER=regula
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- API ------------------------------------------------------------------------------------
JWT_SECRET=                     # obrigatório — string longa e aleatória, ex.: openssl rand -hex 32
ANTHROPIC_API_KEY=              # opcional — sem ela, extração de PDF/Construtor rodam em modo sem IA

# Super Admin criado automaticamente no primeiro boot (login em /admin).
SUPER_ADMIN_EMAIL=admin@suaempresa.com.br
SUPER_ADMIN_PASSWORD=           # obrigatório — troque a senha pela tela de Usuários depois do primeiro login

# NUNCA true num servidor com dado real de cliente: cria um tenant fictício ("Prefeitura de Vale
# Verde") com CRP/Pró-Gestão preenchidos de exemplo e um segundo login de demonstração fixo.
SEED_DEMO_DATA=false

# --- Web ------------------------------------------------------------------------------------
WEB_PORT=80                     # porta do host que serve o frontend (ex.: 80, ou 8080 se já tiver algo na 80)

# URL PÚBLICA real do site (com domínio e https://), usada pelo backend pra redirecionar de
# volta o navegador depois de um login por SSO. Nunca localhost fora do ambiente de dev.
WEB_URL=https://seu-dominio.com.br

# --- Login com Microsoft (Entra ID) — opcional, o botão só aparece se as 4 variáveis abaixo
# estiverem preenchidas. Nunca cria usuário: só entra quem já está cadastrado no Regula RPPS
# com o mesmo e-mail da conta Microsoft.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=         # ex.: https://seu-dominio.com.br/api/auth/microsoft/callback — tem que bater exato com o App Registration

# --- Login com gov.br — opcional, precisa de GOVBR_ENABLED=true + as credenciais abaixo.
GOVBR_ENABLED=false
GOVBR_ISSUER=https://sso.staging.acesso.gov.br   # produção real: https://sso.acesso.gov.br
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=             # ex.: https://seu-dominio.com.br/api/auth/govbr/callback
GOVBR_AUTO_PROVISION=true       # cria conta automaticamente pra quem logar e ainda não existir
GOVBR_PROVISION_ACTIVE=false    # conta criada automaticamente nasce inativa até um Super Admin liberar
