DATABASE_URL="mysql://usuario:senha@localhost:3306/regula_rpps"
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
PORT=3333

# Extração de PDF por IA e geração de rascunhos de documentos compostos (Pró-Gestão).
# Sem esta chave, o upload de PDF ainda salva o arquivo e extrai o texto, mas não gera
# sugestões de preenchimento automático; a geração de rascunho de documento composto usa
# um modo de fallback sem IA (concatenação estruturada dos dados-fonte, sem prosa).
ANTHROPIC_API_KEY=""

# Diretório onde os PDFs enviados pelos usuários são salvos (fora do webroot).
UPLOADS_DIR="./uploads"

# E-mail marcado como Super Admin pelo seed (opcional — sem ela, cai em
# superadmin@regularpps.com.br). Não define senha nenhuma: login é 100% via SSO (Microsoft,
# gov.br ou APP CENTRAL) — a primeira vez que uma conta com este e-mail entrar por qualquer um
# desses provedores já nasce/vira Super Admin.
SUPER_ADMIN_EMAIL=""

# true (padrão de dev) cria o tenant fictício "Prefeitura de Vale Verde" com CRP/Pró-Gestão de
# exemplo — nunca deixar true num deploy com dado real de cliente (ver docker-compose.prod.yml).
SEED_DEMO_DATA=true

# URL do frontend (React) — os fluxos de SSO abaixo redirecionam o navegador de volta pra cá
# depois do login (sempre um redirect, nunca um fetch que a SPA possa ler direto).
WEB_URL="http://localhost:5173"

# --- Login com Microsoft (Entra ID) — opcional, botão só aparece se as 4 variáveis abaixo
# estiverem preenchidas. Nunca cria usuário: só entra quem já está cadastrado no Regula RPPS
# com o mesmo e-mail da conta Microsoft.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI=""   # ex.: https://seu-dominio/auth/microsoft/callback — tem que bater exato com o App Registration
MICROSOFT_SCOPES="openid profile email User.Read"

# --- Login com gov.br — opcional, precisa de GOVBR_ENABLED=true + as credenciais abaixo. Pode
# criar conta automaticamente (inativa até um Super Admin liberar) se AUTO_PROVISION=true.
GOVBR_ENABLED=false
GOVBR_ISSUER="https://sso.staging.acesso.gov.br"   # produção: https://sso.acesso.gov.br
GOVBR_CLIENT_ID=""
GOVBR_CLIENT_SECRET=""
GOVBR_REDIRECT_URI=""   # ex.: https://seu-dominio/auth/govbr/callback
GOVBR_SCOPES="openid email profile"
GOVBR_AUTO_PROVISION=true
GOVBR_PROVISION_ACTIVE=false

# --- Login com o APP CENTRAL — provedor único de login/permissionamento (OIDC + PKCE). Login e
# permissionamento local pra usuários deste provedor vêm 100% de lá (nunca das tabelas Feature
# locais, ver middleware/features.ts). client_id/client_secret nunca vão pro controle de versão —
# preencha só no .env local/produção.
CENTRAL_ISSUER="https://autenticacao.npibrasil.com"
CENTRAL_CLIENT_ID=""
CENTRAL_CLIENT_SECRET=""
CENTRAL_REDIRECT_URI=""   # ex.: https://seu-dominio/auth/central/callback
CENTRAL_TOKEN_URL="https://autenticacao.npibrasil.com/oauth/token"
CENTRAL_INTROSPECT_URL="https://autenticacao.npibrasil.com/api/v1/introspect"
CENTRAL_SCOPES="openid profile email"
