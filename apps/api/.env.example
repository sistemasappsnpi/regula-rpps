DATABASE_URL="mysql://usuario:senha@localhost:3306/regula_rpps"
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
PORT=3333

# Extração de PDF por IA e geração de rascunhos de documentos compostos (Pró-Gestão).
# Sem esta chave, o upload de PDF ainda salva o arquivo e extrai o texto, mas não gera
# sugestões de preenchimento automático; a geração de rascunho de documento composto usa
# um modo de fallback sem IA (concatenação estruturada dos dados-fonte, sem prosa).
ANTHROPIC_API_KEY=""

# Diretório onde os PDFs enviados pelos usuários são salvos (fora do webroot).
UPLOADS_DIR="./uploads"

# Credenciais do Super Admin criado pelo seed (opcional — sem elas, cai em
# superadmin@regularpps.com.br / superadmin123, as credenciais de demonstração de sempre).
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# true (padrão de dev) cria o tenant fictício "Prefeitura de Vale Verde" com CRP/Pró-Gestão de
# exemplo — nunca deixar true num deploy com dado real de cliente (ver docker-compose.prod.yml).
SEED_DEMO_DATA=true
