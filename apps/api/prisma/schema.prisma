datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Plan {
  ESSENCIAL
  GESTAO
  PERFORMANCE
}

enum Role {
  SUPER_ADMIN
  RPPS_ADMIN
  SERVIDOR
  AUDITOR
}

enum CriterionStatus {
  REGULAR
  IRREGULAR
  PENDENTE
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  federatedEntity String
  plan            Plan     @default(ESSENCIAL)
  seguradosCount  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships Membership[]
  crpStatuses TenantCrpCriterion[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships Membership[]

  @@map("users")
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     Role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

model CrpCriterion {
  id          String @id @default(cuid())
  code        String @unique
  category    String
  title       String
  description String @db.Text
  legalBasis  String @db.Text
  periodicity String
  sortOrder   Int    @default(0)

  tenantStatuses TenantCrpCriterion[]

  @@map("crp_criteria")
}

model TenantCrpCriterion {
  id                String          @id @default(cuid())
  tenantId          String
  criterionId       String
  status            CriterionStatus @default(PENDENTE)
  lastSentAt        DateTime?
  nextDueAt         DateTime?
  responsibleUserId String?
  notes             String?         @db.Text
  updatedAt         DateTime        @updatedAt

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criterion CrpCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, criterionId])
  @@index([tenantId])
  @@map("tenant_crp_criteria")
}
