# Serve /robots.txt e /sitemap.xml a partir do config.json. Em servidores sem Apache/mod_rewrite, ignore este arquivo.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # PHP via CGI/FastCGI não recebe o login do painel (admin.php) sem esta linha
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
